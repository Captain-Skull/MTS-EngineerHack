global:
  domain: argocd.{{ .Values.domain }}

configs:
  params:
    server.insecure: true
  cm:
    timeout.reconciliation: 60s
    exec.enabled: false
    statusbadge.enabled: false

dex:
  enabled: false

notifications:
  enabled: false

controller:
  resources:
    requests: { cpu: 50m, memory: 192Mi }
    limits: { memory: 768Mi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

server:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { memory: 256Mi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

repoServer:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { memory: 512Mi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

applicationSet:
  resources:
    requests: { cpu: 10m, memory: 32Mi }
    limits: { memory: 128Mi }

redis:
  resources:
    requests: { cpu: 10m, memory: 32Mi }
    limits: { memory: 128Mi }
